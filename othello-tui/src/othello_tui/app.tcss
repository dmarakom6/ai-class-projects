/* Othello interface preview (monotone)
TCSS is a Textual-specific CSS dialect used to style Textual apps.
 */

Screen {
    background: #000000;
    color: #ffffff;
    layout: vertical;
}

/* -- chrome groups -------------------------------------------------------- */

#top-chrome {
    dock: top;
    width: 100%;
    height: 4;
}

#bottom-chrome {
    dock: bottom;
    width: 100%;
    height: 2;
}

/* -- title ---------------------------------------------------------------- */

#title-bar {
    box-sizing: border-box;
    width: 100%;
    height: 1;
    padding: 0 1;
    background: #ffffff;
    color: #000000;
    text-style: bold;
}

/* -- HUD: round / turn / score / moves ------------------------------------ */

#hud {
    box-sizing: border-box;
    width: 100%;
    height: 3;
    padding: 0 2 0 2;
}

.stat {
    box-sizing: border-box;
    width: 1fr;
    height: 100%;
    margin: 0 1 0 0;
    padding: 0 1;
    background: #000000;
    border-bottom: solid #ffffff;
}

.stat .stat-label {
    box-sizing: border-box;
    width: 100%;
    height: 1;
    color: #909090;
    text-align: center;
    text-style: bold;
}

.stat .stat-value {
    box-sizing: border-box;
    width: 100%;
    height: 1;
    color: #ffffff;
    text-align: center;
    text-style: bold;
}

/* The turn panel shows whose turn it is: dark for black, bright for white. */

#stat-turn.turn-white {
    background: #ffffff;
    color: #000000;
}

#stat-turn.turn-white .stat-label {
    color: #404040;
}

#stat-turn.turn-white .stat-value {
    color: #000000;
}

/* -- board ---------------------------------------------------------------- */

#stage {
    width: 100%;
    height: 1fr;
    align: center middle;
}

#board {
    box-sizing: border-box;
    width: 50;
    height: 26;
    max-width: 100%;
    max-height: 100%;
    background: #454545;
    border: solid #ffffff;
    overflow: hidden hidden;
}

.board-row {
    box-sizing: border-box;
    width: 100%;
    height: 1fr;
}

.cell {
    box-sizing: border-box;
    width: 1fr;
    height: 100%;
    background: #808080;
    color: #000000;
    border-right: solid #454545;
    border-bottom: solid #454545;
    /* Bottom aligned so the glyph sits in the middle of the square: the
       bottom border takes the last row, and the cursor / hover outline is
       drawn over the first and last rows. */
    content-align: center bottom;
    text-style: bold;
}

.cell.last-col {
    border-right: none;
}

.cell.last-row {
    border-bottom: none;
}

.cell.disc-black {
    color: #000000;
}

.cell.disc-white {
    color: #ffffff;
}

/* A possible move: outlined disc on a lighter square. */
.cell.legal {
    background: #c9c9c9;
    color: #000000;
}

.cell:hover {
    outline: solid #ffffff;
}

/* Keyboard cursor: heavy frame, wins over the hover frame. */
.cell.cursor {
    outline: heavy #ffffff;
}

/* -- status line ---------------------------------------------------------- */

#status-line {
    box-sizing: border-box;
    width: 100%;
    height: 1;
    padding: 0 1;
    background: #1f1f1f;
    color: #ffffff;
}

/* -- footer (key hints) --------------------------------------------------- */

#bottom-chrome Footer {
    dock: none;
    width: 100%;
    height: 1;
    background: #000000;
    color: #ffffff;
}

#bottom-chrome FooterLabel {
    background: #000000;
    color: #b0b0b0;
}

#bottom-chrome FooterKey {
    background: #333333;
    color: #ffffff;
}
